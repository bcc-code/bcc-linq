<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>BccCode.Linq.Server</PackageId>
        <Description>Server side of BccCode.Linq: parses Directus-style filters, sorting and paging from API requests into LINQ expressions on IQueryable.</Description>
        <LangVersion>latest</LangVersion>
        <Authors />
        <RootNamespace>BccCode.Linq.Server</RootNamespace>
        <!-- Transitive pinning would pack every pinned transitive package (e.g. Newtonsoft.Json, pinned for the
             tests and pulled in by Contracts) as a direct dependency of the package. -->
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BccCode.Platform.Contracts" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="BccCode.Linq.Tests" />
    </ItemGroup>

</Project>
