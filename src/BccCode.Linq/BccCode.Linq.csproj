<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>BccCode.Linq</PackageId>
        <Description>LINQ query provider for BCC API clients. The server side (filter parsing) is in the BccCode.Linq.Server package.</Description>
        <LangVersion>latest</LangVersion>
        <Authors />
        <RootNamespace>BccCode.Linq</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BccCode.Platform.Contracts" Version="1.0.0.114" />
    </ItemGroup>

</Project>
