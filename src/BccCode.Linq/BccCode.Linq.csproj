<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>BccCode.Linq</PackageId>
        <Description>LINQ query provider for BCC API clients. The server side (filter parsing) is in the BccCode.Linq.Server package.</Description>
        <LangVersion>latest</LangVersion>
        <Authors />
        <RootNamespace>BccCode.Linq</RootNamespace>
        <!-- Transitive pinning would pack every pinned transitive package (e.g. Newtonsoft.Json, pinned for the
             tests and pulled in by Contracts) as a direct dependency of the package. -->
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BccCode.Platform.Contracts" />
    </ItemGroup>

</Project>
