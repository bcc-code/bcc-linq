<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <RootNamespace>BccCode.Linq.AotSmokeTest</RootNamespace>

        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Lock files: this project's lock file lists the ILCompiler runtime packages for both RIDs it is published for
             (CI: linux-x64, local: win-x64). The RID is set here rather than with `dotnet publish -r`: a command-line RID
             is a global property that also reaches BccCode.Linq, whose RID-less lock file then fails a locked restore. -->
        <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\BccCode.Linq\BccCode.Linq.csproj" />
    </ItemGroup>

</Project>
